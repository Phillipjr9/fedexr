{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm ci && npm ci --include=dev --prefix app && npm ci --omit=dev --prefix server",
  "buildCommand": "npm run build",
  "outputDirectory": "app/dist"
}
