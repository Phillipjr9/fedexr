# Copy to .env locally, or configure these in your hosting environment.
# Never commit a populated .env or paste credentials into chat.
# Reuse your EXISTING PostgreSQL database. Account migrations add fedexr_* tables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Alternatively, use NEON_DATABASE_URL instead of DATABASE_URL.

# Exact public website origin, without a path. Production requires HTTPS.
# On Vercel this may be left unset: VERCEL_PROJECT_PRODUCTION_URL (then
# VERCEL_URL) is used, so the origin cannot drift from the deployment host.
APP_ORIGIN=https://your-site.example
# Generate a unique random secret of at least 32 characters in your secret manager.
# AUTH_SECRET wins; JWT_SECRET is accepted as a fallback for existing hosts.
AUTH_SECRET=replace-with-a-unique-random-signing-secret

# Real email delivery is required for verification and recovery. No fake emails are sent.
# SMTP_URL wins. If it is unset, an SMTP URL is derived from RESEND_API_KEY
# (smtps://resend:<key>@smtp.resend.com), and MAIL_FROM falls back to
# RESEND_FROM_EMAIL. The derived password is never logged or returned.
SMTP_URL=smtps://USER:PASSWORD@MAIL_HOST:465
MAIL_FROM=Shipping Workspace <accounts@your-site.example>
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
ACCOUNTS_PORT=3001

# Bootstrap administrator. The account with this email is kept verified, in the
# admin role, and able to sign in with this password, so no shell access to the
# database is needed to create the first administrator. Idempotent: it is a
# no-op once the account is correct, and rotating ADMIN_PASSWORD takes effect on
# the next start. Password must be 10-128 characters (better-auth limit).
# Set ADMIN_EMAIL= (empty) to disable the bootstrap entirely.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Explicit account mode. Browser mode is the current local planning preview.
# Switch to server only AFTER configuring/migrating the account service.
# Verify first: deploy with this still set to browser, then open
# GET /api/account/health and confirm "ready": true, database.schemaInstalled
# true, and adminBootstrap.isAdmin true. Only then set this to server and
# redeploy. The health report is read-only and exposes no secret values.
VITE_WORKSPACE_MODE=browser

# Admin access gate: a pre-shared key required before the admin login form is shown.
# When set, the admin area (login, dashboard, settings) requires this key first.
# When empty or unset, the admin area is open (only the passphrase is required).
# Use a strong random string (32+ characters). This does NOT replace the admin passphrase.
VITE_ADMIN_ACCESS_KEY=
# Internal development proxy only; never included in browser requests.
ACCOUNTS_API_TARGET=http://127.0.0.1:3001

# Optional official FedEx API integration (server-side only; never use VITE_* for these).
# Create a FedEx Developer Portal project, then set its client credentials here.
# Sandbox is the safe default. Production uses live carrier data and real shipments.
FEDEX_ENV=sandbox
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
# Required only for official shipment creation, together with the explicit opt-in below.
FEDEX_ACCOUNT_NUMBER=
FEDEX_CREATE_SHIPMENTS_ENABLED=false
# Optional override for a FedEx-approved API base URL; normally leave unset.
# FEDEX_API_BASE_URL=https://apis-sandbox.fedex.com

# Private application image attachments: server-admin sessions are the normal path.
# Review server/IMAGES.md and the separate images:plan/images:migrate commands.
# Operator compatibility is OFF by default; this is not a fallback for failed sign-in.
ALLOW_LEGACY_IMAGE_KEY=false
# Only if enabling operator mode: use a separate random 32–256 character ASCII key.
# It MUST differ from AUTH_SECRET. Never expose either key through VITE_* variables.
# ADMIN_SECRET=replace-with-a-separate-random-operator-key
